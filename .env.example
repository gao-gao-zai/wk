# 复制为 .env 后按需修改。docker compose 会自动读取同目录的 .env。
#
# 注意：.env 与 config.json 都已加入 .gitignore 和 .dockerignore，
# 不要把它们提交到仓库，也不要把真实凭据写进任何示例文件。

# 必填（仅在使用 docker-compose.postgres.yml 时）：PostgreSQL 密码。
# 未设置时 compose 会直接报错，而不是退化成一个公开的默认密码。
# 生成方式：openssl rand -hex 24
POSTGRES_PASSWORD=

# 可选：不写 config.json 时直接用环境变量提供凭据。
# 两者至少设置一个，否则服务会拒绝启动（所有路由一律 401）。
# 生成方式：openssl rand -hex 32
# WB2A_API_KEY=
# WB2A_FRONTEND_PASSWORD=

# 可选：容器内监听地址。镜像已预置 :7863；仅在需要改端口时覆盖。
# WB2A_LISTEN=:7863

# 可选：会话粘性 HMAC 盐（hex，至少 16 字节）。留空会启动时随机生成，
# 代价是重启后粘性绑定全部重新分配。生成方式：openssl rand -hex 32
# WB2A_SESSION_SALT=

# 可选：可信反向代理（逗号分隔，支持 CIDR）。只有服务确实只在代理后面
# 可达时才设置；否则攻击者伪造 X-Forwarded-For 就能绕开控制台限流。
# WB2A_TRUSTED_PROXIES=172.17.0.0/16

# 可选：上游超时。非流式是整个请求（含读完响应体）的上限，默认 120 秒。
# 注意：只调大它并不能放过长回答——流式由下面两个键单独控制。
# WB2A_TIMEOUT_SECONDS=120

# 可选：流式请求两次收到数据之间的最大间隔，默认 120 秒。上游持续产出时永不触发，
# 只有上游卡住不发数据才失败。设为 -1 可关闭该项检查。
# WB2A_STREAM_IDLE_SECONDS=120

# 可选：流式请求的总时长兜底，默认 0 = 不限。用来防止跑飞的流长期占住账号租约；
# 不建议设成小值，那等于给回答长度设死限。
# WB2A_STREAM_TIMEOUT_SECONDS=0

# 可选：聊天/Responses 请求体大小上限（MiB），默认 8，范围 1-64。
# 请求体会完整读进内存再解析，调大前先确认服务器内存；超限返回 413。
# 控制台「管理设置 → 请求体大小限制」可在线修改（即时生效并写回 config.json）。
# WB2A_MAX_REQUEST_BODY_MIB=8

# 可选：Codex CLI 兼容（默认 false）。打开后把系统提示词里的 Codex 身份句
# 中的 "open source" 最小改写为 "open-source"，绕开上游内容审核的逐字
# 指纹拦截；句子不存在时原样透传，不做别的改动。
# WB2A_CODEX_COMPAT=false
